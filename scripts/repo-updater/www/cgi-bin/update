#!/bin/sh
# GET  ?key=...  shows what is waiting and an "Apply update" button
#                (a button, so link scanners opening the email can't trigger it).
# POST key=...   starts apply.sh in the background; the result arrives by email.
. "$BASE_DIR/scripts/repo-updater/lib.sh"
if [ "$REQUEST_METHOD" = POST ]; then Q=$(head -c "${CONTENT_LENGTH:-0}"); else Q="$QUERY_STRING"; fi
KEY=$(echo "$Q" | tr '&' '\n' | sed -n 's/^key=//p' | head -1)

echo "Content-Type: text/html; charset=utf-8"
echo
page() {
  echo "<!doctype html><meta name=viewport content='width=device-width'><title>$HOST_NAME update</title>"
  echo "<body style='font-family:sans-serif;max-width:40em;margin:1em auto;padding:0 1em'><h2>$HOST_NAME</h2>$1</body>"
}

if [ -z "$REPO_UPDATE_KEY" ] || [ "$KEY" != "$REPO_UPDATE_KEY" ]; then
  page "<p>Wrong or missing key.</p>"; exit 0
fi

if [ "$REQUEST_METHOD" = POST ]; then
  if [ -d "$STATE_DIR/apply.lock" ]; then
    page "<p>An update is already running. The result will arrive by email.</p>"; exit 0
  fi
  setsid sh "$BASE_DIR/scripts/repo-updater/apply.sh" </dev/null >/dev/null 2>&1 &
  page "<p><b>Update started.</b> The result will arrive by email in a minute or two.</p>"
  exit 0
fi

git fetch -q origin "$BRANCH" 2>/dev/null
N=$(git rev-list --count "HEAD..origin/$BRANCH" 2>/dev/null)
esc() { sed 's/&/\&amp;/g;s/</\&lt;/g;s/>/\&gt;/g' | sed 's|.*|<li>&</li>|'; }
LIST=$(git log --format='%h %s' "HEAD..origin/$BRANCH" 2>/dev/null | esc)
FILES=$(relevant_files HEAD "origin/$BRANCH" | esc)
page "<p><b>${N:-?} commit(s) waiting.</b></p><ul>$LIST</ul>
<p>Files that affect this server:</p><ul>${FILES:-<li>none</li>}</ul>
<form method=post><input type=hidden name=key value='$KEY'>
<button style='font-size:1.2em;padding:.5em 1.5em'>Apply update</button></form>
<p><small>Only containers whose settings changed are recreated. Never touched:$SKIP</small></p>"
