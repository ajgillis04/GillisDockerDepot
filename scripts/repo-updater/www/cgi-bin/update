#!/bin/sh
# GET  ?key=...  shows the containers waiting to be upgraded and an "Upgrade" button
#                (a button, so link scanners opening the email can't trigger it).
# POST key=...   starts apply.sh in the background; the result arrives by email.
. "$BASE_DIR/scripts/repo-updater/lib.sh"
if [ "$REQUEST_METHOD" = POST ]; then Q=$(head -c "${CONTENT_LENGTH:-0}"); else Q="$QUERY_STRING"; fi
KEY=$(echo "$Q" | tr '&' '\n' | sed -n 's/^key=//p' | head -1)

echo "Content-Type: text/html; charset=utf-8"
echo
page() { html_head "$1"; echo "$2"; html_foot; }

if [ -z "$REPO_UPDATE_KEY" ] || [ "$KEY" != "$REPO_UPDATE_KEY" ]; then
  page "Not allowed" "<p>Wrong or missing key.</p>"; exit 0
fi

if [ "$REQUEST_METHOD" = POST ]; then
  if [ -d "$STATE_DIR/apply.lock" ]; then
    page "Already running" "<p>An upgrade is already running. The result will arrive by email.</p>"; exit 0
  fi
  setsid sh "$BASE_DIR/scripts/repo-updater/apply.sh" </dev/null >/dev/null 2>&1 &
  page "Upgrade started" "<p>The result will arrive by email in a minute or two.</p>"
  exit 0
fi

classify
BODY=""
if [ -n "$UP" ]; then
  BODY="$(html_section "Containers to upgrade"; html_chips "$UP" "#dbeafe")
<form method=post style=\"margin:24px 0 8px\"><input type=hidden name=key value=\"$KEY\">
<button style=\"background:#2563eb;color:#fff;border:0;padding:12px 22px;border-radius:8px;font-weight:600;font-size:16px\">Upgrade$( [ "$(echo $UP | wc -w)" -gt 1 ] && echo " these" )</button></form>"
else
  BODY="<p>Nothing waiting to be upgraded.</p>"
fi
[ -n "$PROT" ] && BODY="$BODY$(html_section "Changed, do by hand (protected)"; html_chips "$PROT" "#fde68a")"
[ -n "$STOP" ] && BODY="$BODY$(html_section "Changed but stopped (left alone)"; html_chips "$STOP" "#e5e7eb")"
[ -n "$NEWS" ] && BODY="$BODY$(html_section "New, start by hand"; html_chips "$NEWS" "#dcfce7")"
[ -s "$COMMITS" ] && BODY="$BODY$(html_section "Commits"; html_commits "$COMMITS")"
page "Updates" "$BODY"
